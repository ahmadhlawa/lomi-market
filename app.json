{
  "expo": {
    "name": "Lomi Market",
    "slug": "lomi-market",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "lomi-market",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ps.lomi.market"
    },
    "android": {
      "package": "ps.lomi.market",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#111111"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "supportsRTL": true
    }
  }
}
